# Copie para .env na VPS. Nunca envie o .env real ao Git.
# O frontend usa a mesma origem; nenhum segredo recebe prefixo VITE_.
DOMAIN=play.gfig.space
ACME_EMAIL=CONFIGURE_SEU_EMAIL
# host: reaproveita Caddy/Nginx existente; standalone: proxy Docker nas portas 80/443.
REVERSE_PROXY_MODE=standalone
GAME_BIND_PORT=2567
PUBLIC_ORIGIN=https://play.gfig.space
ALLOWED_ORIGINS=https://play.gfig.space
NODE_ENV=production
PORT=2567
HOST=0.0.0.0
DATA_DIR=/data
ROOM_LIMIT=32
MAX_CLIENTS=256
ROOM_IDLE_SECONDS=1800
ROOM_RESUME_SECONDS=120
ROOM_SNAPSHOT_HZ=10
SIMULATION_HZ=30
DRAIN_TIMEOUT_SECONDS=120
# Imagem imutável usada pelo CI. Em branco: build local pelo deploy.sh.
GAME_IMAGE=

# OPCIONAL: backup externo R2. Não é necessário para jogar online.
# Requer AWS CLI no computador/VPS que executa deploy-r2-backup.mjs.
R2_ENDPOINT=https://a9cf0f539d37afe46de8c5d1aec58cdf.r2.cloudflarestorage.com
R2_BUCKET=clients
R2_ASSET_PREFIX=games
R2_PUBLIC_URL=https://assets.gfig.space/games
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Backup externo exige bucket privado separado do bucket de assets.
BACKUP_R2_BUCKET=

# OPCIONAL, somente no build de um frontend servido em outro domínio.
# Mesmo domínio da VPS: deixe vazio; o cliente usa wss://DOMINIO/ws.
VITE_SERVER_URL=
VITE_PHASE_API_URL=
# CDN opcional: deixe vazio até configurar R2, domínio público e CORS.
VITE_ASSET_BASE_URL=
